AUTOMAT_URL=http://localhost:3000
AUTOMAT_TOKEN=
AUTOMAT_UPLOAD_ENABLED=true

# Kosz: ile dni skasowane zdjecia/sesje leza w photos/.trash zanim znikna
# naprawde. 0 = kasowanie natychmiastowe (bez kosza).
TRASH_RETENTION_DAYS=30

# Backend aparatu: auto (gphoto2 jesli dostepne; na Windows edsdk) /
# gphoto2 / edsdk. Szczegoly Windows: WINDOWS.md.
CAMERA_BACKEND=auto

# Ramie RoArm-M2-S (USB-C, JSON po serialu 115200). false = panel „Robot"
# znika i nic nie jest otwierane. Port pusty = autodetekcja po VID plytki.
ROBOT_ENABLED=true
ROBOT_PORT=
# Ujecia kamery: CZTERY KATY PRZEGUBOW w stopniach (j1,j2,j3,j4). Wypisuje je
# tools/roarm_teach.py — puszcza serwa, ustawiasz ramie recznie tak, jak ma
# robic zdjecie, ENTER zapisuje. Aplikacja odtwarza te katy co do stopnia, wiec
# pozycja jest ZAWSZE ta sama; nie ma odleglosci ani kata do regulacji.
# Pusto = ujecie nieustawione (panel mowi to wprost, ramie nie rusza).
ROBOT_JOINTS_TOP90=
ROBOT_JOINTS_A45=
# Os 4 jako nadgarstek (kamera), nie chwytak.
ROBOT_WRIST_MODE=true
# Przejazd do pozycji domowej po polaczeniu. Przy sterowaniu katami zbedny
# (cel jest bezwzgledny), wiec OFF: ramie z aparatem nie ma ruszac samo zaraz
# po starcie aplikacji.
ROBOT_HOME_ON_CONNECT=false
# Predkosc i przyspieszenie (spd 1..4096, acc 1..254). Osobno dla ramienia i dla
# osi 4: tam obraca sie sama glowica, wiec moze chodzic szybciej niz wysieg,
# ktory przenosi szarpniecie na stol.
ROBOT_MOVE_SPEED=200
ROBOT_MOVE_ACC=10
ROBOT_JOINT_SPEED=1200
ROBOT_JOINT_ACC=40
# Canon EDSDK: sciezka do EDSDK.dll lub katalogu z nia (domyslnie szukana
# obok aplikacji). DLL-ki x64 z programu deweloperskiego Canona — nie sa w repo.
EDSDK_DLL=
