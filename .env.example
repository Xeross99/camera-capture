AUTOMAT_URL=http://localhost:3000
AUTOMAT_TOKEN=
AUTOMAT_UPLOAD_ENABLED=true

# Kosz: ile dni skasowane zdjecia/sesje leza w photos/.trash zanim znikna
# naprawde. 0 = kasowanie natychmiastowe (bez kosza).
TRASH_RETENTION_DAYS=30

# Backend aparatu: auto (gphoto2 jesli dostepne; na Windows edsdk) /
# gphoto2 / edsdk. Szczegoly Windows: WINDOWS.md.
CAMERA_BACKEND=auto

# Ramie RoArm-M2-S (USB-C, JSON po serialu 115200). false = panel „Robot"
# znika i nic nie jest otwierane. Port pusty = autodetekcja po VID plytki.
ROBOT_ENABLED=true
ROBOT_PORT=
# Piata os: dodatkowe serwo ST3215 na magistrali ramienia ZA osia 4 (koniec
# wysiegnika), pochyla kamere — dzieki niemu jedno ustawienie produktu daje
# i ujecie z gory, i skos 45. Wymaga firmware z firmware/roarm_m2_ext_servo/
# (fabryczny zna tylko serwa 11-15) i nadania serwu ID
# (tools/roarm_ext_servo_id.py). 0 = fabryczne ramie bez piatej osi.
ROBOT_EXT_SERVO_ID=16
# Ujecia kamery: KATY PRZEGUBOW w stopniach, tyle liczb ile osi
# (j1,j2,j3,j4,j5 — albo 4 przy ROBOT_EXT_SERVO_ID=0). Wypisuje je
# tools/roarm_teach.py — puszcza serwa, ustawiasz ramie recznie tak, jak ma
# robic zdjecie, ENTER zapisuje. Aplikacja odtwarza te katy co do stopnia, wiec
# pozycja jest ZAWSZE ta sama; nie ma odleglosci ani kata do regulacji.
# Pusto = ujecie nieustawione (panel mowi to wprost, ramie nie rusza).
# Wpis z inna liczba katow niz osi jest pomijany — po dolozeniu serwa ujecia
# trzeba ustawic od nowa.
ROBOT_JOINTS_TOP90=
ROBOT_JOINTS_A45=
# Os 4 jako nadgarstek (kamera), nie chwytak.
ROBOT_WRIST_MODE=true
# Przejazd do pozycji domowej po polaczeniu. Przy sterowaniu katami zbedny
# (cel jest bezwzgledny), wiec OFF: ramie z aparatem nie ma ruszac samo zaraz
# po starcie aplikacji.
ROBOT_HOME_ON_CONNECT=false
# Predkosc i przyspieszenie (spd 1..4096, acc 1..254). Osobno dla ramienia i dla
# osi 4: tam obraca sie sama glowica, wiec moze chodzic szybciej niz wysieg,
# ktory przenosi szarpniecie na stol.
ROBOT_MOVE_SPEED=200
ROBOT_MOVE_ACC=10
ROBOT_JOINT_SPEED=1200
ROBOT_JOINT_ACC=40
# Przejazd w dwoch fazach: cel wyzej = najpierw bark+lokiec (podniesienie),
# potem obrot podstawy/glowicy/pochylenia; cel nizej = odwrotnie. Bez tego
# glowica z aparatem obracala sie przy blacie i obijala o podloge. Domyslnie
# OFF (jeden plynny ruch jest ~2x szybszy) — wlacz, gdy aparat zahacza o blat.
ROBOT_LIFT_FIRST=false
# Dociaganie po dojezdzie: serwo pod ciezarem aparatu zatrzymuje sie z
# bledem ustalonym (kadr „lekko nizej"). Po przejezdzie ramie dosyla
# poprawiony cel per os, az kazda jest w ROBOT_SETTLE_TOL od ujecia,
# maksymalnie ROBOT_SETTLE_ROUNDS razy. 0 rund = wylaczone.
ROBOT_SETTLE_TOL=0.5
ROBOT_SETTLE_ROUNDS=4
# Canon EDSDK: sciezka do EDSDK.dll lub katalogu z nia (domyslnie szukana
# obok aplikacji). DLL-ki x64 z programu deweloperskiego Canona — nie sa w repo.
EDSDK_DLL=
# EDSDK w osobnym procesie: zawieszke w DLL-u Canona konczy zabicie procesu
# i swieza inicjalizacja SDK, zamiast martwej aplikacji. false = stary tryb.
CAMERA_EDSDK_ISOLATION=true
# FPS podgladu przy starcie (1-30). Zmiana w Ustawieniach zapisuje sie tutaj
# sama. Na maszynach z kaprysnym USB nizszy FPS = mniej okazji do zawieszek.
PREVIEW_FPS=30
# Motyw aplikacji okienkowej: dark / light. Przelacznik w Ustawieniach → Wyglad
# zapisuje wybor tutaj.
UI_THEME=dark
