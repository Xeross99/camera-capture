+// === === === extra bus servo (ext_servo.h) === === ===
+// a servo on the bus BEYOND the factory IDs 11-15, e.g. a camera tilt
+// joint on ID 16. angle: deg, 0 = servo middle (pos 2047), -180..180.
+// spd: raw steps/s (0 = max), acc: raw steps (0 = no ramp).
+// {"T":130,"id":16,"angle":30.0,"spd":1200,"acc":40}
+#define CMD_EXT_SERVO_ANGLE 130
+
+// read one servo -> {"T":1131,"id":16,"ok":1,"angle":30.1,"pos":2389,...}
+// {"T":131,"id":16}
+#define CMD_EXT_SERVO_FEEDBACK 131
+
+// torque of one servo: 0 - release, 1 - hold.
+// {"T":132,"id":16,"cmd":1}
+#define CMD_EXT_SERVO_TORQUE 132
+
+// change a servo ID, safe for ANY raw id (501 indexes servoFeedback[raw-11]).
+// {"T":134,"raw":1,"new":16}
+#define CMD_EXT_SERVO_SET_ID 134
+
+
+
